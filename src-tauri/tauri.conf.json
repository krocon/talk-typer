{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Talk Typer",
  "version": "../package.json",
  "identifier": "io.github.krocon.talk-typer",
  "build": {
    "frontendDist": "../dist/talk-typer/browser",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "pnpm start:desktop",
    "beforeBuildCommand": "pnpm build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talk Typer",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Lokale Spracherkennung mit Whisper",
    "longDescription": "Talk Typer wandelt Sprache vollständig lokal mit OpenAI Whisper in Text um. Kein Audio und kein Text verlässt das Gerät.",
    "homepage": "https://github.com/krocon/talk-typer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
